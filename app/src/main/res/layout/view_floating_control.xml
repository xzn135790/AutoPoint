<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/floatingWindowContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/floatingPanel"
        android:layout_width="200dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_floating_panel"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/floatingStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="待机"
                android:textColor="@color/app_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/executeModeButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="开始录制"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/crosshairModeButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="取点"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/recordModeButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="录制"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

    <LinearLayout
        android:id="@+id/executeActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/floatingStartButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="使用方案"
            android:textColor="@color/app_primary" />

        <Button
            android:id="@+id/floatingPauseButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="暂停"
            android:textColor="@color/app_warning" />

        <Button
            android:id="@+id/floatingStopButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="停止"
            android:textColor="@color/app_text_secondary" />

        <Button
            android:id="@+id/closeFloatingButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="关闭"
            android:textColor="@color/app_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/crosshairActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/addClickPointButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="添加点击"
            android:textColor="@color/app_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/setSwipeStartButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="滑动起点"
            android:textColor="@color/app_warning"
            android:textSize="12sp" />

        <Button
            android:id="@+id/setSwipeEndButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="滑动终点"
            android:textColor="@color/app_success"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/recordingActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/stopRecordingButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="保存"
            android:textColor="@color/app_primary" />

        <Button
            android:id="@+id/undoRecordedStepButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="撤销上一步"
            android:textColor="@color/app_warning" />

        <Button
            android:id="@+id/useRecordedPlanButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="使用方案"
            android:textColor="@color/app_success" />

        <Button
            android:id="@+id/closeRecordingButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="关闭"
            android:textColor="@color/app_text_secondary" />
    </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/resizeHandle"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:layout_gravity="end|bottom"
            android:gravity="center"
            android:text="↘"
            android:textColor="@color/app_text_secondary"
            android:textSize="20sp" />
    </FrameLayout>
</FrameLayout>
