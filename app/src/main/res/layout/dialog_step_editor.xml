<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RadioGroup
            android:id="@+id/typeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/clickTypeRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="点击" />

            <RadioButton
                android:id="@+id/swipeTypeRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="滑动" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="起点坐标"
            android:textColor="@color/app_text_primary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/startXInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="X"
                android:inputType="number" />

            <Space android:layout_width="10dp" android:layout_height="1dp" />

            <EditText
                android:id="@+id/startYInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Y"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/endPointGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="终点坐标"
                android:textColor="@color/app_text_primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/endXInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="X"
                    android:inputType="number" />

                <Space android:layout_width="10dp" android:layout_height="1dp" />

                <EditText
                    android:id="@+id/endYInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Y"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="执行前延时（毫秒）"
            android:textColor="@color/app_text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/delayInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="例如：300"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/delayRandomInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="延时随机偏差，例如：10"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="点击/滑动持续时间（毫秒）"
            android:textColor="@color/app_text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/durationInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="例如：80"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/durationRandomInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="持续时间随机偏差，例如：10"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="随机偏差半径（像素）"
            android:textColor="@color/app_text_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/randomRadiusInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="例如：0"
            android:inputType="number"
            android:maxLines="1" />
    </LinearLayout>
</ScrollView>
